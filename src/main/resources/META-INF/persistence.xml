<?xml version="1.0" encoding="UTF-8"?>
<!--
    persistence.xml - Arquivo de configuração do JPA (Jakarta Persistence API).
    
    Define a "Persistence Unit" que configura:
    - Qual provedor JPA usar (Hibernate)
    - Conexão com o banco de dados MySQL
    - Comportamento do Hibernate (criação automática de tabelas, log de SQL, etc.)
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="paybol-pu" transaction-type="RESOURCE_LOCAL">

        <!-- Provedor JPA: Hibernate ORM -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Classe da entidade mapeada -->
        <class>com.paybol.model.Jogador</class>

        <properties>
            <!-- ========== Conexão com o MySQL ========== -->
            
            <!-- Driver JDBC do MySQL -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            
            <!-- URL de conexão: localhost, porta 3306, banco paybol_db -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/paybol_db?useSSL=false&amp;serverTimezone=America/Manaus&amp;allowPublicKeyRetrieval=true"/>
            
            <!-- Usuário do MySQL -->
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            
            <!-- Senha do MySQL (altere conforme sua instalação) -->
            <property name="jakarta.persistence.jdbc.password" value="root"/>

            <!-- ========== Configurações do Hibernate ========== -->
            
            <!-- Dialeto SQL específico para MySQL 8 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            
            <!-- 
                hbm2ddl.auto = update
                O Hibernate cria/atualiza as tabelas automaticamente
                baseado nas entidades JPA. Muito útil em desenvolvimento.
            -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            
            <!-- Mostra as queries SQL no console (útil para apresentação) -->
            <property name="hibernate.show_sql" value="true"/>
            
            <!-- Formata o SQL para melhor legibilidade no console -->
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>
</persistence>
